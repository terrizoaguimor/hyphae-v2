# Models (large — re-downloaded via scripts/download-model.sh)
models/
*.gguf

# Smoke and ad-hoc scratch — runnable; not paper artifacts
results/smoke-*.json
results/scratch-*.json

# The published v0.1 comparator artifacts ARE checked in (per
# ADR-0027 — reproducibility requires the JSON envelopes to ship
# with the writeup). Future versioned runs follow the
# `v{N}-{hardware}-{mode}.json` naming convention.

# Exported corpus + Hyphae outputs + echo intermediates (all
# regenerated; deterministic given the corpus source). The SCORED
# envelopes under results/ are checked in; these raw intermediates
# are not.
corpus-en.json
corpus-es.json
hyphae-results.json
hyphae-results-*.json
echo-results-*.json

# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
dist/
build/

# uv cache
.uv-cache/

# HF cache layered under repo
.cache/

# Test scratch
.pytest_cache/
.mypy_cache/
.ruff_cache/
